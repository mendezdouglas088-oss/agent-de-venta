# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_admin_id_here

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Userbot Configuration
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=your_phone_number_here

# Backend API Configuration (for userbot)
BACKEND_API_KEY=your_backend_api_key_here
BACKEND_URL=http://backend:3000

# Database Configuration (optional, uses defaults if not set)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=telegram_ai

# Redis Configuration (optional, uses defaults if not set)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Node Environment
NODE_ENV=development
